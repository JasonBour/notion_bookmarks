# Notion配置
NOTION_TOKEN=your-notion-token
NOTION_LINKS_DB_ID=your-links-db-id
NOTION_WEBSITE_CONFIG_ID=your-website-config-db-id
NOTION_CATEGORIES_DB_ID=your-categories-db-id
NOTION_SUB_CATEGORIES_DB_ID=your-sub-categories-db-id

# 分析和统计
NEXT_PUBLIC_CLARITY_ID=your-clarity-id
GA_ID=your-ga-id

# 页面重新验证时间（秒）
REVALIDATE_TIME=360

# 个人美股盯盘页（/watch）
# WATCH_PASSWORD 是访问口令，也是 /api/watch 的接口令牌，必须设置
WATCH_PASSWORD=your-watch-password
# FINNHUB_KEY 可选：配了用 Finnhub 拿美股实时价，没配则退回腾讯/Yahoo
FINNHUB_KEY=your-finnhub-key
# WATCH_STRATEGY 可选：策略 JSON。配了就用它，不配则读仓库内 src/app/api/watch/strategy.json
# WATCH_STRATEGY={"version":1,"stocks":[]}

# 可选：网站URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000